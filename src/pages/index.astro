---
// src/pages/index.astro
// Configura aquí el número de teléfono que recibirá las respuestas (Código de país + número, sin espacios ni '+')
const NUMERO_WHATSAPP = "974357754";
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Preguntas para ti - José Luis</title>
  </head>
  <body
    class="bg-purple-100 min-h-screen flex flex-col items-center justify-center p-4 font-sans text-center"
  >
    <!-- TEXTO INICIAL Y BOTÓN CELESTE -->
    <div class="space-y-4 max-w-md">
      <h1 class="text-xl md:text-2xl font-bold text-purple-900">
        José Luis tiene algunas preguntas para ti...
      </h1>
      <div>
        <button
          type="button"
          id="btnAbrir"
          class="bg-sky-400 hover:bg-sky-500 text-slate-900 font-bold py-3 px-6 rounded-lg shadow-md transition-colors cursor-pointer"
        >
          presiona aqui
        </button>
      </div>
    </div>

    <!-- VENTANA MODAL CON LAS PREGUNTAS -->
    <div
      id="modal"
      class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4 hidden text-left"
      role="dialog"
      aria-modal="true"
      aria-labelledby="tituloModal"
    >
      <div
        class="bg-white rounded-2xl p-7 w-full max-w-lg relative shadow-2xl max-h-[90vh] overflow-y-auto"
      >
        <!-- BOTÓN CERRAR (X) -->
        <button
          type="button"
          id="btnCerrar"
          class="absolute top-3 right-4 text-slate-400 hover:text-slate-600 text-2xl font-bold cursor-pointer"
          aria-label="Cerrar modal"
        >
          &times;
        </button>

        <h2 id="tituloModal" class="text-lg font-bold text-purple-900 mb-4">
          Responde estas preguntitas para José Luis 🎮✨
        </h2>

        <!-- FORMULARIO DE PREGUNTAS -->
        <form id="formularioCuestionario" class="space-y-5">
          
          <!-- PREGUNTA 1 -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">
              1. ¿Cuándo es mi cumpleaños? 🍰 *
            </label>
            <select
              id="p1"
              required
              class="w-full border border-slate-300 rounded-lg p-2.5 text-xs outline-none focus:border-purple-600 text-slate-700 bg-white"
            >
              <option value="">Selecciona una opción</option>
              <option value="15 de febrero">15 de febrero</option>
              <option value="1 de abril">1 de abril</option>
              <option value="20 de julio">20 de julio</option>
              <option value="5 de noviembre">5 de noviembre</option>
            </select>
          </div>

          <!-- PREGUNTA 2 -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">
              2. ¿Qué es lo que más me gusta hacer? 😎 *
            </label>
            <select
              id="p2"
              required
              class="w-full border border-slate-300 rounded-lg p-2.5 text-xs outline-none focus:border-purple-600 text-slate-700 bg-white"
            >
              <option value="">Selecciona una opción</option>
              <option value="Programar">Programar</option>
              <option value="Jugar videojuegos">Jugar videojuegos</option>
              <option value="pasear en bicicleta">pasear en bicicleta</option>
              <option value="nose, nunca me lo dijo_xd">nose, nunca me lo dijo_xd</option>
            </select>
          </div>

          <!-- PREGUNTA 3 -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">
              3. ¿Qué dice Mateo 6:33_xd? 📖 *
            </label>
            <select
              id="p3"
              required
              class="w-full border border-slate-300 rounded-lg p-2.5 text-xs outline-none focus:border-purple-600 text-slate-700 bg-white"
            >
              <option value="">Selecciona una opción</option>
              <option value="Mas buscad primeramente el reino de Dios y su justicia, y todas estas cosas os serán añadidas.">Mas buscad primeramente el reino de Dios y su justicia, y todas estas cosas os serán añadidas.</option>
              <option value="Todo lo puedo en Cristo que me fortalece.">Todo lo puedo en Cristo que me fortalece.</option>
              <option value="Jehová es mi pastor; nada me faltará.">Jehová es mi pastor; nada me faltará.</option>
            </select>
          </div>

          <!-- PREGUNTA 4 (EXTRA) -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">
              4. ¿Quieres que José Luis se inspire así para desarrollar un sistema de invitación personalizada para ti? 👨‍💻💻 *
            </label>
            <select
              id="p4"
              required
              class="w-full border border-slate-300 rounded-lg p-2.5 text-xs outline-none focus:border-purple-600 text-slate-700 bg-white"
            >
              <option value="">Selecciona una opción</option>
              <option value="¡Sí, por supuesto! Sería genial">¡Sí, por supuesto! Sería genial</option>
              <option value="Tal vez, lo voy pensando">Tal vez, lo voy pensando</option>
              <option value="No lo sé, ¡sorpréndeme!">No lo sé, ¡sorpréndeme!</option>
            </select>
          </div>

          <!-- BOTÓN DE ENVÍO -->
          <button
            type="submit"
            id="btnEnviar"
            class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-4 rounded-lg text-sm transition-colors cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Enviar respuestas a WhatsApp</span>
          </button>
        </form>
      </div>
    </div>

    <!-- MODAL DE CONFIRMACIÓN (ESTÁS SEGURA) -->
    <div
      id="modalConfirmacion"
      class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4 hidden text-center"
    >
      <div class="bg-white rounded-2xl p-6 w-full max-w-xs shadow-2xl space-y-4">
        <h3 class="text-base font-bold text-slate-800">
          ¿Estás segura de que respondiste bien todo??
        </h3>
        <div class="flex gap-2 justify-center pt-2">
          <button
            type="button"
            id="btnNoCancelar"
            class="flex-1 bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold py-2 px-3 rounded-lg text-xs cursor-pointer"
          >
            no_cancelar
          </button>
          <button
            type="button"
            id="btnSiiEnviar"
            class="flex-1 bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-3 rounded-lg text-xs cursor-pointer"
          >
            sii_enviar
          </button>
        </div>
      </div>
    </div>

    <!-- SCRIPT DE MANEJO DE MODAL, CONFIRMACIÓN, SPINNER Y WHATSAPP -->
    <script is:inline define:vars={{ NUMERO_WHATSAPP }}>
      document.addEventListener("DOMContentLoaded", () => {
        const btnAbrir = document.getElementById("btnAbrir");
        const btnCerrar = document.getElementById("btnCerrar");
        const modal = document.getElementById("modal");
        const modalConfirmacion = document.getElementById("modalConfirmacion");
        const formulario = document.getElementById("formularioCuestionario");
        const btnSiiEnviar = document.getElementById("btnSiiEnviar");
        const btnNoCancelar = document.getElementById("btnNoCancelar");
        const btnEnviar = document.getElementById("btnEnviar");

        function abrirModal() {
          modal?.classList.remove("hidden");
          document.body.style.overflow = "hidden";
          document.getElementById("p1")?.focus();
        }

        function cerrarModal() {
          modal?.classList.add("hidden");
          document.body.style.overflow = "auto";
          btnAbrir?.focus();
        }

        btnAbrir?.addEventListener("click", abrirModal);
        btnCerrar?.addEventListener("click", cerrarModal);

        // Cerrar al hacer clic en el fondo oscuro
        modal?.addEventListener("click", (evento) => {
          if (evento.target === modal) cerrarModal();
        });

        // Cerrar con tecla Escape
        document.addEventListener("keydown", (evento) => {
          if (evento.key === "Escape" && !modal?.classList.contains("hidden")) {
            cerrarModal();
          }
        });

        // Interceptar el envío del formulario para mostrar la confirmación
        formulario?.addEventListener("submit", (evento) => {
          evento.preventDefault();
          modalConfirmacion?.classList.remove("hidden");
        });

        // Si elige "no_cancelar", se cierra la confirmación y vuelve al formulario
        btnNoCancelar?.addEventListener("click", () => {
          modalConfirmacion?.classList.add("hidden");
        });

        // Si elige "sii_enviar", activamos el spinner y redirigimos a WhatsApp
        btnSiiEnviar?.addEventListener("click", () => {
          modalConfirmacion?.classList.add("hidden");

          // Cambiar el botón de envío para mostrar el Spinner de carga
          btnEnviar.disabled = true;
          btnEnviar.innerHTML = `
            <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>Generando y abriendo WhatsApp...</span>
          `;

          const p1 = document.getElementById("p1").value;
          const p2 = document.getElementById("p2").value;
          const p3 = document.getElementById("p3").value;
          const p4 = document.getElementById("p4").value;

          // Construir mensaje estructurado para WhatsApp
          const textoWhatsApp = `✨ *RESPUESTAS DEL CUESTIONARIO* ✨

1️⃣ *¿Cuándo es mi cumpleaños?*
👉Respuesta_1: ${ p1}

2️⃣ *¿Qué es lo que más me gusta hacer?*
👉Respuesta_2: ${p2}

3️⃣ *¿Qué dice Mateo 6:33_xd?*
👉Respuesta_3: ${p3}

4️⃣ *¿Quieres que José Luis se inspire así para desarrollar un sistema de invitación personalizada para ti?*
👉Respuesta_4: ${p4}`;

          const mensajeEncriptado = encodeURIComponent(textoWhatsApp);
          const urlWhatsApp = `https://wa.me/${NUMERO_WHATSAPP}?text=${mensajeEncriptado}`;

          // Esperar 1.5 segundos simulando el spinner de carga antes de redirigir
          setTimeout(() => {
            window.location.href = urlWhatsApp;
          }, 1500);
        });
      });
    </script>
  </body>
</html>